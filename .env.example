# ==========================================
# LLM Provider Configuration
# ==========================================

# Option A: OpenRouter (Recommended for multi-model access)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
# Examples of popular OpenRouter models:
# - openai/gpt-4o
# - openai/gpt-4o-mini
# - anthropic/claude-3.5-sonnet
# - google/gemini-2.5-flash
# - meta-llama/llama-3.3-70b-instruct

# Option B: Direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Optional: App URL for OpenRouter ranking headers
APP_URL=https://your-railway-app.up.railway.app

# ==========================================
# Stripe Billing Configuration
# ==========================================
# Stripe Secret Key (for live/test payment processing)
# Leave empty or omitted to run in test/mock payment mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==========================================
# Admin Configuration
# ==========================================
ADMIN_PASSWORD=admin123

# ==========================================
# Database Configuration
# ==========================================
# Default: sqlite:///billing.db (auto-created if missing)
# Production Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///billing.db

# ==========================================
# Outbound Email Delivery (Invites & Receipts)
# ==========================================
# Option A: Resend (Recommended: https://resend.com - 3000 free emails/mo)
RESEND_API_KEY=re_...
EMAIL_FROM=The Ram & Chisel <onboarding@resend.dev>

# Option B: Standard SMTP (Gmail, Outlook, Amazon SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true